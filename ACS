function Get-CachedProcessHash {
    param([Parameter(Mandatory = $true)]$Process)

    $startTicks = try { $Process.StartTime.Ticks } catch { 0 }
    $key = "$($Process.Id)_$startTicks"

    if ($Global:ProcessHashCache.ContainsKey($key)) {
        return $Global:ProcessHashCache[$key]
    }

    try {
        $hash = (Get-FileHash -LiteralPath $Process.Path -Algorithm SHA256 -ErrorAction Stop).Hash
    } catch {
        return $null
    }
    Set-BoundedCacheEntry -Cache $Global:ProcessHashCache -Key $key -Value $hash -MaxSize 1500
    return $hash
}

