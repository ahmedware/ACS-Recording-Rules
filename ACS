function Set-BoundedCacheEntry {
    param(
        [Parameter(Mandatory = $true)][System.Collections.IDictionary]$Cache,
        [Parameter(Mandatory = $true)]$Key,
        [Parameter(Mandatory = $true)]$Value,
        [int]$MaxSize = 2000
    )
    if ($Cache.Count -ge $MaxSize -and -not $Cache.ContainsKey($Key)) {
        $evictCount = [Math]::Max(1, [int]($MaxSize * 0.1))
        foreach ($staleKey in @($Cache.Keys | Select-Object -First $evictCount)) {
            $Cache.Remove($staleKey)
        }
    }
    $Cache[$Key] = $Value
}

