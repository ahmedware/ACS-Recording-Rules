function Test-InjectedRobloxModules {
    $robloxProcs = Get-Process -Name "RobloxPlayerBeta" -ErrorAction SilentlyContinue
    foreach ($proc in $robloxProcs) {
        try {
            foreach ($module in $proc.Modules) {
                $path = $module.FileName
                if (-not $path) { continue }
                $inTempOrDownloads = $path -match "\\(Temp|Downloads|AppData\\Local\\Temp)\\"

                $fingerprint = $null
                try {
                    $fi = Get-Item -LiteralPath $path -ErrorAction Stop
                    $fingerprint = "$($fi.Length)|$($fi.LastWriteTimeUtc.Ticks)"
                } catch {}

                $cached = $Global:ModuleSigCache[$path]
                if ($cached -and $fingerprint -and $cached.Fingerprint -eq $fingerprint) {
                    $sigStatus = $cached.SigStatus
                    $trustedPublisher = $cached.TrustedPublisher
                } else {
                    $sig = $null
                    try { $sig = Get-AuthenticodeSignature -LiteralPath $path -ErrorAction Stop } catch {}
                    $sigStatus = if ($sig) { $sig.Status } else { "Unknown" }
                    $trustedPublisher = $false
                    if ($sigStatus -eq "Valid") {
                        foreach ($pub in $AcsTrustedModulePublishers) {
                            if ($sig.SignerCertificate.Subject -match [regex]::Escape($pub)) { $trustedPublisher = $true; break }
                        }
                    }
                    if ($fingerprint) {
                        Set-BoundedCacheEntry -Cache $Global:ModuleSigCache -Key $path -Value ([pscustomobject]@{ Fingerprint = $fingerprint; SigStatus = $sigStatus; TrustedPublisher = $trustedPublisher }) -MaxSize 3000
                    }
                }

                if ($trustedPublisher) {
                    if (Test-AcsSeenOnce -Set $Global:AcsLoggedWhitelistKeys -Key "InjectedModules|$path") {
                        Write-WhitelistLog ("Recognized publisher (list: AcsTrustedModulePublishers): {0} -- module still logged below, not skipped." -f $path)
                    }
                }

                if (Test-AcsSeenOnce -Set $Global:AcsLoggedFindingKeys -Key "InjectedModules|$path") {
                    if ($inTempOrDownloads -and $sigStatus -ne "Valid") {
                        Write-MonitorLog ("Unsigned/suspicious module in Roblox (PID {0}) logged: {1} (signature: {2}, loaded from Temp/Downloads){3}{4}" -f $proc.Id, $path, $sigStatus, (Get-AcsReviewNote -Identifier $path), (Get-AcsNewSinceLastSessionNote -Identifier $path)) Red -Severity High
                    } else {
                        Write-MonitorLog ("Unrecognized module in Roblox (PID {0}) logged: {1} (signature: {2}){3}{4}" -f $proc.Id, $path, $sigStatus, (Get-AcsReviewNote -Identifier $path), (Get-AcsNewSinceLastSessionNote -Identifier $path)) Yellow -Severity Medium
                    }
                }
            }
        } catch {}
    }
}

