function Test-LogChainIntegrity {
    param([string]$LogPath)
    if (-not (Test-Path $LogPath)) { return "SKIPPED: log file not found" }

    $lines = Get-Content -LiteralPath $LogPath
    $running = "GENESIS"
    $lineNumber = 0
    for ($i = 0; $i -lt $lines.Count; $i += 2) {
        $lineNumber++
        $content_line = $lines[$i]
        $chainLine = if ($i + 1 -lt $lines.Count) { $lines[$i + 1] } else { $null }

        $expected = Get-ChainHash -PreviousHash $running -Line $content_line
        $expectedTag = "[chain:$expected]"

        if ($chainLine -ne $expectedTag) {
            return "FAILURE: chain broken at entry $lineNumber -- log may have been edited or reordered after the fact"
        }
        $running = $expected
    }
    return "SUCCESS: all $lineNumber log entries verified, chain intact"
}

function Find-SevenZip {
    $candidates = @(
        "$env:ProgramFiles\7-Zip\7z.exe",
        "${env:ProgramFiles(x86)}\7-Zip\7z.exe"
    )
    foreach ($candidate in $candidates) {
        if (Test-Path $candidate) { return $candidate }
    }
    $onPath = Get-Command "7z.exe" -ErrorAction SilentlyContinue
    if ($onPath) { return $onPath.Source }
    return $null
}

