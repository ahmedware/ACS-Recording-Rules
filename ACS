function Test-ProcessHasDebugPrivilege {
    param([Parameter(Mandatory = $true)][int]$ProcessId)
    if (-not $Global:AcsPrivCheckAvailable) { return $false }

    $PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
    $TOKEN_QUERY = 0x0008
    $TokenPrivileges = 3
    $SE_PRIVILEGE_ENABLED = 0x2

    $hProcess = [IntPtr]::Zero
    $hToken = [IntPtr]::Zero
    $buffer = [IntPtr]::Zero
    try {
        $hProcess = [AcsPrivCheck]::OpenProcess($PROCESS_QUERY_LIMITED_INFORMATION, $false, $ProcessId)
        if ($hProcess -eq [IntPtr]::Zero) { return $false }
        if (-not [AcsPrivCheck]::OpenProcessToken($hProcess, $TOKEN_QUERY, [ref]$hToken)) { return $false }

        $debugLuid = New-Object AcsPrivCheck+LUID
        if (-not [AcsPrivCheck]::LookupPrivilegeValue($null, "SeDebugPrivilege", [ref]$debugLuid)) { return $false }

        $neededLen = 0
        [void][AcsPrivCheck]::GetTokenInformation($hToken, $TokenPrivileges, [IntPtr]::Zero, 0, [ref]$neededLen)
        if ($neededLen -le 0) { return $false }
        $buffer = [System.Runtime.InteropServices.Marshal]::AllocHGlobal($neededLen)
        if (-not [AcsPrivCheck]::GetTokenInformation($hToken, $TokenPrivileges, $buffer, $neededLen, [ref]$neededLen)) { return $false }

        $count = [System.Runtime.InteropServices.Marshal]::ReadInt32($buffer)
        $entrySize = [System.Runtime.InteropServices.Marshal]::SizeOf([type]"AcsPrivCheck+LUID_AND_ATTRIBUTES")
        for ($i = 0; $i -lt $count; $i++) {
            $offset = [IntPtr]::Add($buffer, 4 + ($i * $entrySize))
            $entry = [System.Runtime.InteropServices.Marshal]::PtrToStructure($offset, [type]"AcsPrivCheck+LUID_AND_ATTRIBUTES")
            if ($entry.Luid.LowPart -eq $debugLuid.LowPart -and $entry.Luid.HighPart -eq $debugLuid.HighPart) {
                return (($entry.Attributes -band $SE_PRIVILEGE_ENABLED) -ne 0)
            }
        }
        return $false
    } catch {
        return $false
    } finally {
        if ($buffer -ne [IntPtr]::Zero) { [System.Runtime.InteropServices.Marshal]::FreeHGlobal($buffer) }
        if ($hToken -ne [IntPtr]::Zero) { [AcsPrivCheck]::CloseHandle($hToken) | Out-Null }
        if ($hProcess -ne [IntPtr]::Zero) { [AcsPrivCheck]::CloseHandle($hProcess) | Out-Null }
    }
}

