    if (-not $Global:AcsReviewedFindingsPath) { Write-Host "[WARN] No persistent data dir available -- can't save." -ForegroundColor Yellow; return }
    $Global:AcsReviewedFindings[$Identifier] = [pscustomobject]@{
        Verdict    = $Verdict
        Note       = $Note
        ReviewedAt = (Get-Date).ToString("o")
