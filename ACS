                    'Examiner Time' = $times.Local
                    'Last Execution Time (UTC)' = $times.Utc
                    'Last Execution User Time' = $times.User
                    Application = $fileName
                    Path = $filePath
                    Signature = $signature
                    User = $userName
                    SID = $sid
                    Regpath = $regRoot
                }
            } catch { continue }
        }
    }
}

