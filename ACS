function Test-RobloxFFlagOverrides {
    if (-not $Global:AcsFFlagBaselineCaptured) { Initialize-FFlagBaseline; return }

    $current = Get-FFlagSnapshot
    $before = if ($Global:AcsFFlagBaseline) { $Global:AcsFFlagBaseline } else { @{} }
    $after = if ($current) { $current } else { @{} }

    $added = @($after.Keys | Where-Object { -not $before.ContainsKey($_) })
    $removed = @($before.Keys | Where-Object { -not $after.ContainsKey($_) })
    $changed = @($after.Keys | Where-Object { $before.ContainsKey($_) -and $before[$_] -ne $after[$_] })

    if ($added.Count -eq 0 -and $removed.Count -eq 0 -and $changed.Count -eq 0) { return }

    foreach ($k in $added) {
        $severity = if ($k -match $Global:AcsSuspiciousFlagNamePattern) { "High" } else { "Medium" }
        Write-MonitorLog ("FFlag override ADDED mid-session: {0} = {1}" -f $k, $after[$k]) Red -Severity $severity
    }
    foreach ($k in $changed) {
        $severity = if ($k -match $Global:AcsSuspiciousFlagNamePattern) { "High" } else { "Medium" }
        Write-MonitorLog ("FFlag override CHANGED mid-session: {0} was '{1}', now '{2}'" -f $k, $before[$k], $after[$k]) Red -Severity $severity
    }
    foreach ($k in $removed) {
        Write-MonitorLog ("FFlag override REMOVED mid-session: {0} (was '{1}')" -f $k, $before[$k]) Yellow -Severity Low
    }

    $Global:AcsFFlagBaseline = $after
}

