# Token-boundary keyword matching -- a fragment only matches when it's a whole
# "word" (bounded by start/end/\_-. or whitespace), not just any substring.
# This is what keeps generic entries like "photon", "clarity", or "monolith"
# from firing on unrelated software that merely contains those letters.
function Test-AcsKeywordTokenMatch {
    param(
        [Parameter(Mandatory = $true)][string]$Text,
        [Parameter(Mandatory = $true)][string]$Keyword
    )
    if ([string]::IsNullOrWhiteSpace($Text) -or [string]::IsNullOrWhiteSpace($Keyword)) { return $false }
    $escaped = [regex]::Escape($Keyword)
    return [regex]::IsMatch($Text, "(?i)(^|[\\_\s\-\.])($escaped)($|[\\_\s\-\.])")
}

function Get-AcsMatchedCheatKeyword {
    param([Parameter(Mandatory = $true)][string]$Text)
    foreach ($kw in $KnownCheatNameFragments) {
        if (Test-AcsKeywordTokenMatch -Text $Text -Keyword $kw) { return $kw }
    }
    return $null
}

