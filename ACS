if (-not $Global:AcsCrc32Available) {
    try {
        Add-Type -TypeDefinition @"
using System;
using System.IO;

public static class AcsCrc32
{
    private static readonly uint[] Table = BuildTable();

    private static uint[] BuildTable()
    {
        uint[] table = new uint[256];
        for (uint i = 0; i < table.Length; i++)
        {
            uint v = i;
            for (int b = 0; b < 8; b++)
                v = ((v & 1u) != 0) ? (0xEDB88320u ^ (v >> 1)) : (v >> 1);
            table[i] = v;
        }
        return table;
    }

    public static string Compute(string path)
    {
        uint crc = uint.MaxValue;
        byte[] buffer = new byte[1024 * 1024];

        using (FileStream fs = new FileStream(path, FileMode.Open, FileAccess.Read,
            FileShare.ReadWrite | FileShare.Delete, buffer.Length, FileOptions.SequentialScan))
        {
            int n;
            while ((n = fs.Read(buffer, 0, buffer.Length)) > 0)
            {
                for (int i = 0; i < n; i++)
                    crc = Table[(crc ^ buffer[i]) & 0xFFu] ^ (crc >> 8);
            }
        }
        return (~crc).ToString("X8");
    }
}
"@ -ErrorAction Stop
        $Global:AcsCrc32Available = $true
    } catch {

        Write-Host "[WARN] Couldn't compile the CRC32 helper (often AV blocking the temp DLL) -- integrity manifest will show CRC32 as N/A, everything else (SHA256/SHA512, the zip itself) is unaffected: $($_.Exception.Message)" -ForegroundColor Yellow
        $Global:AcsCrc32Available = $false
    }
}

