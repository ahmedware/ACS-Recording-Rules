function Test-DefenderRegistryPath {
    param([string]$Path)
    $name = Split-Path $Path -Leaf
    if (-not (Test-Path $Path)) { return "SUCCESS: '$name' not present (OK)" }
    try {
        $props = Get-ItemProperty -LiteralPath $Path -ErrorAction Stop
        $values = @($props.PSObject.Properties | Where-Object { $_.Name -notlike "PS*" })
        if ($values.Count -eq 0) { return "SUCCESS: '$name' is empty (OK)" }
        $valueText = ($values | ForEach-Object { "$($_.Name)=$($_.Value)" }) -join ", "
        return "FAILURE: '$name' has values set: [$valueText]"
    } catch [System.UnauthorizedAccessException] {
        return "INFO: '$name' exists but is OS-protected (access denied) -- not necessarily a violation"
    } catch {
        return "WARNING: '$name' Couldn't be read: $($_.Exception.Message)"
    }
}

