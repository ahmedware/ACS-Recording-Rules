function PackageEvidence {

    if ($Global:PackagingStarted) { return }
    $Global:PackagingStarted = $true

    try {
        Write-MonitorLog "Packaging evidence (triggered)..." Cyan -NoConsole

        Save-AcsSessionScreenshot -Label "session_end"

        Show-PackagingProgress -Stage "Saving system & security info"
        Save-Text -Name "system_info.txt" -Data ($SpecsLog -join "`r`n")
        Save-Text -Name "powershell_check.txt" -Data ($psIntegrityOutput -join "`r`n")
        Save-Text -Name "security_summary.txt" -Data (($secureBootOutput + $coreIsolationOutput + $antivirusOutput + $defenderOutput + $selfIntegrityOutput) -join "`r`n")

        Show-PackagingProgress -Stage "Saving process & service info"

        $procTasklist = Start-Process -FilePath "$env:SystemRoot\System32\tasklist.exe" -ArgumentList "/v" `
            -RedirectStandardOutput (Join-Path $outputPath "process_list.txt") -WindowStyle Hidden -PassThru
        $procDriverquery = Start-Process -FilePath "$env:SystemRoot\System32\driverquery.exe" -ArgumentList "/v" `
            -RedirectStandardOutput (Join-Path $outputPath "driver_list.txt") -WindowStyle Hidden -PassThru
        $procNetstat = Start-Process -FilePath "$env:SystemRoot\System32\netstat.exe" -ArgumentList "-abno" `
            -RedirectStandardOutput (Join-Path $outputPath "network_connections.txt") -WindowStyle Hidden -PassThru

        Save-Command -Name "process_details.txt" -Command {
            Get-CimInstance Win32_Process | Select-Object ProcessId, Name, ExecutablePath, CommandLine | Format-List
        }
        Save-Command -Name "services_list.txt" -Command { Get-Service | Sort-Object Status, Name | Format-List }
        Save-Text -Name "background_services.txt" -Data ($serviceOutput -join "`r`n")

        foreach ($p in @($procTasklist, $procDriverquery, $procNetstat)) {
            try {
                if (-not $p.WaitForExit(15000)) { $p.Kill() }
            } catch {}
        }

        Show-PackagingProgress -Stage "Exporting relevant event logs"
        $logDirectory = Join-Path $outputPath "artifacts"
        New-Item -ItemType Directory -Path $logDirectory -Force | Out-Null

        $eventChannels = @("System", "Application", "Security")
        $eventExportJobs = foreach ($channel in $eventChannels) {
            $exportPath = Join-Path $logDirectory "$channel.evtx"
            try {
                Start-Process -FilePath "$env:SystemRoot\System32\wevtutil.exe" `
                    -ArgumentList @("epl", $channel, "`"$exportPath`"", "/ow:true") `
                    -WindowStyle Hidden -PassThru -ErrorAction SilentlyContinue
            } catch { $null }
        }

        $prefetchDest = Join-Path $logDirectory "Prefetch"
        try {
            $pfFiles = Get-ChildItem -Path "C:\Windows\Prefetch" -Filter *.pf -ErrorAction SilentlyContinue
            if ($pfFiles -and $pfFiles.Count -le 2000) {
                New-Item -ItemType Directory -Path $prefetchDest -Force | Out-Null
                $pfFiles | Copy-Item -Destination $prefetchDest -Force -ErrorAction SilentlyContinue
            }
        } catch {}

        $eventExportDeadline = (Get-Date).AddSeconds(20)
        foreach ($job in $eventExportJobs) {
            if (-not $job) { continue }
            $remainingMs = [Math]::Max(0, ($eventExportDeadline - (Get-Date)).TotalMilliseconds)
            try {
                if (-not $job.WaitForExit([int]$remainingMs)) { $job.Kill() }
            } catch {}
        }

        Show-PackagingProgress -Stage "Reading MUI cache & recent files"
        $muiPaths = @(
            "HKCU:\Software\Classes\Local Settings\Software\Microsoft\Windows\Shell\MuiCache"
            "HKCU:\Software\Microsoft\Windows\ShellNoRoam\MUICache"
        )
        $muiOutput = New-Object System.Collections.Generic.List[string]
        foreach ($muiPath in $muiPaths) {
            if (-not (Test-Path $muiPath)) { continue }
            $muiOutput.Add("registry path: $muiPath")
            try { $muiOutput.Add((Get-ItemProperty -Path $muiPath | Out-String)) }
            catch { $muiOutput.Add("failed reading muicache") }
        }
        Save-Text -Name "mui_cache.txt" -Data ($muiOutput -join "`r`n")

        $recentPath = Join-Path $env:APPDATA "Microsoft\Windows\Recent"
        if (Test-Path $recentPath) {
            Copy-Item -Path $recentPath -Destination (Join-Path $logDirectory "recent_files") -Recurse -Force -ErrorAction SilentlyContinue
        }

        Show-PackagingProgress -Stage "Parsing prefetch, Amcache, ShellBags & USN journal"

        $pfHandle = Start-PrefetchCollection
        $amHandle = Start-AmcacheCollection
        $sbeHandle = Start-ShellBagsCollection
        Collect-BAM *> $null
        Collect-UsnJournalActivity *> $null

        $parseDeadline = (Get-Date).AddSeconds(45)
        foreach ($h in @($pfHandle, $amHandle, $sbeHandle)) {
            if (-not $h) { continue }
            $remainingMs = [Math]::Max(0, ($parseDeadline - (Get-Date)).TotalMilliseconds)
            try {
                if (-not $h.Process.WaitForExit([int]$remainingMs)) { $h.Process.Kill() }
            } catch {}
        }

        Complete-PrefetchCollection -Handle $pfHandle
        Complete-AmcacheCollection -Handle $amHandle
        Complete-ShellBagsCollection -Handle $sbeHandle

        Show-PackagingProgress -Stage "Verifying session log chain"
        $logChainResult = Test-LogChainIntegrity -LogPath $monitorLogPath
        $driverLogChainResult = Test-LogChainIntegrity -LogPath $driverLogPath
        Save-Text -Name "log_chain_verification.txt" -Data (@(
            "session_monitor.log: $logChainResult",
            "Suspicious Driver Check.log: $driverLogChainResult"
        ) -join "`r`n")

        Show-PackagingProgress -Stage "Writing severity summary"
        $severitySummaryLines = @()
        $severitySummaryLines += "Findings by severity this session:"
        $severitySummaryLines += ""
        foreach ($tier in @("Critical", "High", "Medium", "Low")) {
            $severitySummaryLines += ("{0,-10}: {1}" -f $tier, $Global:SeverityCounts[$tier])
        }
        $severitySummaryLines += ""
        $severitySummaryLines += "Critical = confirmed hash/driver match (auto-terminated where applicable)"
        $severitySummaryLines += "High     = strong single-source signal (overlay window, external handle, injected module, name/title or string-signature match, hidden dropper)"
        $severitySummaryLines += "Medium   = real but needs context (API hook, network IOC, single string marker, PyInstaller artifact)"
        $severitySummaryLines += "Low      = informational (unconfirmed sample logged for reference)"
        Save-Text -Name "severity_summary.txt" -Data ($severitySummaryLines -join "`r`n")

        Show-PackagingProgress -Stage "Exporting structured JSON log"
        try {
            $jsonPath = Join-Path $outputPath "session_monitor.json"
            ($Global:StructuredLogEntries | ConvertTo-Json -Depth 5) | Out-File -LiteralPath $jsonPath -Encoding utf8 -ErrorAction Stop
        } catch {
            Write-MonitorLog ("Structured JSON log export failed: {0}" -f $_.Exception.Message) Yellow -NoConsole
        }

        Show-PackagingProgress -Stage "Updating cross-session history"

        if ($Global:AcsSessionHistoryPath) {
            try {
                $merged = New-Object System.Collections.Generic.HashSet[string]
                foreach ($x in $Global:AcsKnownItemsFromPriorSessions) { $null = $merged.Add($x) }
                foreach ($x in $Global:AcsKnownItemsThisSession) { $null = $merged.Add($x) }

                $maxHistoryItems = 20000
                $mergedArray = @($merged)
                if ($mergedArray.Count -gt $maxHistoryItems) {
                    $keep = New-Object System.Collections.Generic.HashSet[string]
                    foreach ($x in $Global:AcsKnownItemsThisSession) { $null = $keep.Add($x) }
                    foreach ($x in ($mergedArray | Select-Object -First ($maxHistoryItems - $keep.Count))) { $null = $keep.Add($x) }
                    $mergedArray = @($keep)
                }
                ($mergedArray | ConvertTo-Json -Depth 2) | Out-File -LiteralPath $Global:AcsSessionHistoryPath -Encoding utf8 -ErrorAction Stop
            } catch {
                Write-MonitorLog ("Cross-session history update failed: {0}" -f $_.Exception.Message) Yellow -NoConsole
            }
        }

        Show-PackagingProgress -Stage "Generating integrity manifest"
        $manifestPath = Join-Path $outputPath "checksums.txt"
        New-IntegrityManifest -DirectoryPath $outputPath -ManifestPath $manifestPath

        Show-PackagingProgress -Stage "Creating zip archive"

        $sevenZipPath = Find-SevenZip
        $zipIsPasswordProtected = $false

        if ($sevenZipPath -and $Global:EvidenceZipPassword) {
            try {
                $sevenZipArgs = @(
                    "a", "-tzip", "-mem=AES256", "-p$($Global:EvidenceZipPassword)", "-mmt=on",
                    $zipPath, "$outputPath\*"
                )
                & $sevenZipPath @sevenZipArgs | Out-Null
                if ($LASTEXITCODE -eq 0 -and (Test-Path $zipPath)) {
                    $zipIsPasswordProtected = $true
                }
            } catch {
                $zipIsPasswordProtected = $false
            }
        }

        if (-not $zipIsPasswordProtected) {
            Compress-Archive -Path "$outputPath\*" -DestinationPath $zipPath -CompressionLevel Optimal -Force
        }

        Show-PackagingProgress -Stage "Verifying archive hash"
        $zipCrc32 = Get-Crc32 -Path $zipPath
        $zipSha256 = (Get-FileHash -LiteralPath $zipPath -Algorithm SHA256).Hash
        $zipSha512 = (Get-FileHash -LiteralPath $zipPath -Algorithm SHA512).Hash

        $Global:LoggingActive = $false
        Remove-Item -LiteralPath $outputPath -Recurse -Force -ErrorAction SilentlyContinue

        Write-MonitorLog ("Packaging complete. Archive: {0} SHA256: {1} Password-protected: {2}" -f $zipPath, $zipSha256, $zipIsPasswordProtected) Cyan -NoConsole

        Write-Host ""
        Write-Host "============================================================" -ForegroundColor Green
        Write-Host "  Recording package ready" -ForegroundColor Green
        Write-Host "============================================================" -ForegroundColor Green
        Write-Host "  Folder   : $outputRoot" -ForegroundColor White
        Write-Host "  File     : $zipPath" -ForegroundColor White
        Write-Host "  SHA256   : $zipSha256" -ForegroundColor White
        if ($zipIsPasswordProtected) {
            Write-Host "  Password : Protected (AES-256 via 7-Zip)" -ForegroundColor White
        } else {
            Write-Host "  Password : NOT protected -- 7-Zip wasn't found at C:\Program Files\7-Zip\7z.exe (or on PATH), so this zip is a plain unencrypted archive. Install 7-Zip on this machine if password protection is required." -ForegroundColor Yellow
        }
        Write-Host "  Log chain: session_monitor.log -- $logChainResult" -ForegroundColor White
        Write-Host "  Log chain: Suspicious Driver Check.log -- $driverLogChainResult" -ForegroundColor White
        Write-Host ("  Findings : Critical={0}  High={1}  Medium={2}  Low={3}" -f $Global:SeverityCounts.Critical, $Global:SeverityCounts.High, $Global:SeverityCounts.Medium, $Global:SeverityCounts.Low) -ForegroundColor White
        Write-Host "============================================================" -ForegroundColor Green

        Reset-Proxy

    } catch {
        Write-MonitorLog ("ERROR during packaging: {0}" -f $_.Exception.Message) Red
        Write-Host ""
        Write-Host "[PACKAGING FAILED] $($_.Exception.Message)" -ForegroundColor Red
        Write-Host "Evidence folder was left in place instead of being deleted, so you don't lose what was collected: $outputPath" -ForegroundColor Yellow

        Reset-Proxy
    }
}

