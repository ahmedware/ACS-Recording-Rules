function Get-RelativePath {
    param([Parameter(Mandatory = $true)][string]$BasePath, [Parameter(Mandatory = $true)][string]$TargetPath)
    $resolvedBase = [System.IO.Path]::GetFullPath($BasePath)
    $resolvedTarget = [System.IO.Path]::GetFullPath($TargetPath)
    $separator = [System.IO.Path]::DirectorySeparatorChar
    if (-not $resolvedBase.EndsWith([string]$separator)) { $resolvedBase += $separator }
    $baseUri = New-Object System.Uri($resolvedBase)
    $targetUri = New-Object System.Uri($resolvedTarget)
    $relativeUri = $baseUri.MakeRelativeUri($targetUri)
    return [System.Uri]::UnescapeDataString($relativeUri.ToString()).Replace("/", "\")
}

function Get-FileIntegrity {

    param([Parameter(Mandatory = $true)][string]$Path, [string]$RelativeTo)
    $resolvedPath = (Resolve-Path -LiteralPath $Path).Path
    $file = Get-Item -LiteralPath $resolvedPath
    $relativePath = if ($RelativeTo) { Get-RelativePath -BasePath $RelativeTo -TargetPath $resolvedPath } else { $file.Name }

    return [pscustomobject]@{
        Path = $relativePath
        Size = $file.Length
        SHA256 = (Get-FileHash -LiteralPath $resolvedPath -Algorithm SHA256).Hash
    }
}

function New-IntegrityManifest {

    param([Parameter(Mandatory = $true)][string]$DirectoryPath, [Parameter(Mandatory = $true)][string]$ManifestPath)

    $files = @(Get-ChildItem -LiteralPath $DirectoryPath -File -Recurse -ErrorAction SilentlyContinue |
        Where-Object { $_.FullName -ne $ManifestPath })

    $output = New-Object System.Collections.Generic.List[string]
    $output.Add("format version: 2 (SHA256 only -- CRC32/SHA512 dropped as redundant, cut manifest generation time significantly)")
    $output.Add("created (UTC): $([DateTime]::UtcNow.ToString('O'))")
    $output.Add("file count: $($files.Count)")
    $output.Add("")

    if ($files.Count -eq 0) {
        $output | Out-File -LiteralPath $ManifestPath -Encoding utf8 -Force
        return
    }

    $maxThreads = [Math]::Min(8, [Environment]::ProcessorCount)
    $pool = [runspacefactory]::CreateRunspacePool(1, $maxThreads)
    $pool.Open()
    $tasks = New-Object System.Collections.Generic.List[object]

    $hashScript = {
        param($FullName, $BaseDir)
        try {
            $item = Get-Item -LiteralPath $FullName -ErrorAction Stop
            $hash = (Get-FileHash -LiteralPath $FullName -Algorithm SHA256 -ErrorAction Stop).Hash
            $rel = $FullName.Substring($BaseDir.Length).TrimStart('\', '/')
            [pscustomobject]@{ Path = $rel; Size = $item.Length; SHA256 = $hash }
        } catch {
            [pscustomobject]@{ Path = $FullName; Size = 0; SHA256 = "ERROR: $($_.Exception.Message)" }
        }
    }

    try {
        $baseFull = (Resolve-Path -LiteralPath $DirectoryPath).Path
        foreach ($file in $files) {
            $ps = [powershell]::Create()
            $ps.RunspacePool = $pool
            [void]$ps.AddScript($hashScript).AddArgument($file.FullName).AddArgument($baseFull)
            $tasks.Add([pscustomobject]@{ Pipe = $ps; Handle = $ps.BeginInvoke() })
        }

        $results = foreach ($t in $tasks) {
            try { $t.Pipe.EndInvoke($t.Handle) } finally { $t.Pipe.Dispose() }
        }
    } finally {
        $pool.Close()
        $pool.Dispose()
    }

    foreach ($r in ($results | Sort-Object Path)) {
        $output.Add("path: $($r.Path)")
        $output.Add("size: $($r.Size)")
        $output.Add("sha256: $($r.SHA256)")
        $output.Add("")
    }

    $output | Out-File -LiteralPath $ManifestPath -Encoding utf8 -Force
}

