function Merge-RemoteCheatSignatures {

    if (-not $Global:REMOTE_SIGNATURES_URL) { return }

    try {
        $tempPath = Join-Path $env:TEMP ("ach_sigs_{0}.json" -f (Get-Random))
        Save-RemoteFile -Uri $Global:REMOTE_SIGNATURES_URL -Path $tempPath

        if ($Global:REMOTE_SIGNATURES_EXPECTED_SHA256) {
            $actualHash = (Get-FileHash -LiteralPath $tempPath -Algorithm SHA256).Hash
            if ($actualHash -ne $Global:REMOTE_SIGNATURES_EXPECTED_SHA256) {
                Write-ColoredLine "[WARN] Remote signature file hash mismatch (got $actualHash) -- ignoring it." Yellow
                Remove-Item -LiteralPath $tempPath -Force -ErrorAction SilentlyContinue
                return
            }
        } else {
            Write-ColoredLine "[WARN] No pinned hash set for remote signature file -- merging unverified." Yellow
        }

        $parsed = Get-Content -LiteralPath $tempPath -Raw | ConvertFrom-Json -ErrorAction Stop

        if ($parsed.hashes) {
            foreach ($prop in $parsed.hashes.PSObject.Properties) {
                $script:KnownCheatHashes[$prop.Name.ToUpper()] = $prop.Value
            }
        }
        if ($parsed.nameFragments) {
            $script:KnownCheatNameFragments = @($script:KnownCheatNameFragments) + @($parsed.nameFragments)
        }
        if ($parsed.stringSignatures) {
            foreach ($prop in $parsed.stringSignatures.PSObject.Properties) {
                $script:CheatFileStringSignatures[$prop.Name] = @($prop.Value)
            }
        }

        Write-ColoredLine "[OK] Merged remote signature updates from $Global:REMOTE_SIGNATURES_URL" Green
        Remove-Item -LiteralPath $tempPath -Force -ErrorAction SilentlyContinue
    } catch {
        Write-ColoredLine "[WARN] Couldn't fetch/merge remote signatures: $($_.Exception.Message)" Yellow
    }
}

