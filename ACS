function Write-MonitorLog {
    param(
        [Parameter(Mandatory = $true)][string]$Line,
        [ConsoleColor]$Color = 'White',
        [Switch]$NoConsole,
        [ValidateSet("Critical", "High", "Medium", "Low", "Info")][string]$Severity = "Info"
    )

    if ($Severity -ne "Info") { $Global:SeverityCounts[$Severity]++ }
    $stamped = "[{0}] [{1}] {2}" -f (Get-Date -Format "HH:mm:ss"), $Severity.ToUpper(), $Line
    $Global:StructuredLogEntries.Add([pscustomobject]@{
        Timestamp = (Get-Date).ToString("o")
        Severity  = $Severity
        Message   = $Line
    })

    if ($Global:LoggingActive -eq $false) { return }

    try {
        $Global:LogChainHash = Get-ChainHash -PreviousHash $Global:LogChainHash -Line $stamped
        Add-Content -LiteralPath $monitorLogPath -Value $stamped -ErrorAction Stop
        Add-Content -LiteralPath $monitorLogPath -Value "[chain:$Global:LogChainHash]" -ErrorAction Stop
    } catch {

    }

    if ($NoConsole) { return }

    if ($Global:MonitorQuiet) {

        $shortStamp = "[{0}] LOGGED" -f (Get-Date -Format "HH:mm:ss")
        Write-Host $shortStamp -ForegroundColor Green
    } else {
        Write-Host $stamped -ForegroundColor $Color
    }
}

function Write-MonitorLogRaw {
    param(
