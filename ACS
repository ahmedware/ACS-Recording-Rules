function Test-RobloxApiHooks {
    param([string]$ProcessName = "RobloxPlayerBeta")

    if (-not $Global:AcsHookCheckAvailable) { return }

    $proc = Get-Process -Name $ProcessName -ErrorAction SilentlyContinue | Select-Object -First 1
    if (-not $proc) { return }

    $hProcess = [IntPtr]::Zero
    try {
        $hProcess = [AcsHookCheck]::OpenProcess($PROCESS_VM_READ -bor $PROCESS_QUERY_INFORMATION, $false, $proc.Id)
    } catch {

        Write-MonitorLog ("Hook scan: OpenProcess failed: {0}" -f $_.Exception.Message) Yellow -NoConsole
        return
    }
    if ($hProcess -eq [IntPtr]::Zero) {
        Write-MonitorLog "Hook scan: couldn't open RobloxPlayerBeta for VM read (insufficient rights or process gone)" Yellow -NoConsole
        return
    }

    try {
        foreach ($target in $AcsHookCheckFunctions) {
            try {
                $hModule = [AcsHookCheck]::GetModuleHandle($target.Module)
                if ($hModule -eq [IntPtr]::Zero) { continue }
                $procAddr = [AcsHookCheck]::GetProcAddress($hModule, $target.Name)
                if ($procAddr -eq [IntPtr]::Zero) { continue }

                $localBytes = New-Object byte[] 16
                [Runtime.InteropServices.Marshal]::Copy($procAddr, $localBytes, 0, 16)

                $remoteBytes = New-Object byte[] 16
                $bytesRead = 0
                $ok = [AcsHookCheck]::ReadProcessMemory($hProcess, $procAddr, $remoteBytes, 16, [ref]$bytesRead)
                if (-not $ok -or $bytesRead -lt 16) { continue }

                $differs = $false
                for ($i = 0; $i -lt 16; $i++) {
                    if ($localBytes[$i] -ne $remoteBytes[$i]) { $differs = $true; break }
                }
                if (-not $differs) { continue }

                $b0 = $remoteBytes[0]
                $looksLikeHook = $false
                if ($b0 -eq 0xE9 -or $b0 -eq 0xE8) { $looksLikeHook = $true }
                elseif ($b0 -eq 0xFF -and ($remoteBytes[1] -eq 0x25 -or $remoteBytes[1] -eq 0x15)) { $looksLikeHook = $true }
                elseif ($b0 -eq 0x68 -and $remoteBytes[5] -eq 0xC3) { $looksLikeHook = $true }
                elseif ($b0 -eq 0x48 -and $remoteBytes[1] -eq 0xB8 -and $remoteBytes[10] -eq 0xFF -and $remoteBytes[11] -eq 0xE0) { $looksLikeHook = $true }

                if ($looksLikeHook) {
                    $localHex = ($localBytes | ForEach-Object { $_.ToString("X2") }) -join " "
                    $remoteHex = ($remoteBytes | ForEach-Object { $_.ToString("X2") }) -join " "
                    Write-MonitorLog ("API hook logged in {0}: {1}!{2} differs from clean baseline (clean=[{3}] roblox=[{4}])" -f $ProcessName, $target.Module, $target.Name, $localHex, $remoteHex) Red -Severity Medium
                }
            } catch {}
        }
    } finally {
        [AcsHookCheck]::CloseHandle($hProcess) | Out-Null
    }
}

