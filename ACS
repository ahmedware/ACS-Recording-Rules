function Collect-UsnJournalActivity {
    $output = Join-Path $outputPath "usn_journal_activity.txt"
    if (-not $Global:AcsUsnStart) {
        "USN journal: no starting position was captured at session start (see session_monitor.log) -- skipped." | Out-File -LiteralPath $output -Encoding utf8
        return
    }

    try {
        $raw = & fsutil usn readjournal $Global:AcsUsnStartVolume csv "startusn=$($Global:AcsUsnStart)" 2>&1
        if (-not $raw) {
            "USN journal: no records returned for this session's window." | Out-File -LiteralPath $output -Encoding utf8
            return
        }

        $rawOut = Join-Path $outputPath "usn_journal_raw.csv"
        $raw | Out-File -LiteralPath $rawOut -Encoding utf8

        $interesting = $raw | Where-Object {
            ($_ -match '\.(exe|dll|sys|pyd|bat|ps1)"?,') -and
            ($_ -match 'FileCreate|FileDelete|RenameNewName|RenameOldName|Close')
        }

        $summary = New-Object System.Collections.Generic.List[string]
        $summary.Add("USN Journal activity on $($Global:AcsUsnStartVolume), from session start (startusn=$($Global:AcsUsnStart)) to packaging time.")
        $summary.Add("NOTE: journal records carry filename + parent-folder reference, not a full path -- full path reconstruction needs an MFT walk, not done here.")
        $summary.Add("Full unfiltered records are in usn_journal_raw.csv alongside this file.")
        $summary.Add("")
        $summary.Add("Filtered to executable-ish extensions with create/delete/rename activity:")
        $summary.Add("")
        if ($interesting) {
            $summary.AddRange([string[]]$interesting)
        } else {
            $summary.Add("(none matched the filter this session)")
        }
        $summary -join "`r`n" | Out-File -LiteralPath $output -Encoding utf8
    } catch {
        ("USN journal collection failed: {0}" -f $_.Exception.Message) | Out-File -LiteralPath $output -Encoding utf8
    }
}

