function Test-ThreadStartAddresses {
    param([string]$ProcessName = "RobloxPlayerBeta")

    if (-not $Global:AcsThreadCheckAvailable) { return }

    $proc = Get-Process -Name $ProcessName -ErrorAction SilentlyContinue | Select-Object -First 1
    if (-not $proc) { return }

    $ranges = New-Object System.Collections.Generic.List[psobject]
    try {
        foreach ($m in $proc.Modules) {
            $base = [Int64]$m.BaseAddress
            $ranges.Add([pscustomobject]@{ Start = $base; End = ($base + [Int64]$m.ModuleMemorySize); Name = $m.ModuleName })
        }
    } catch {

        Write-MonitorLog ("Thread scan: couldn't enumerate modules for {0}: {1}" -f $ProcessName, $_.Exception.Message) Yellow -NoConsole
        return
    }
    if ($ranges.Count -eq 0) { return }

    $hSnap = [AcsThreadCheck]::CreateToolhelp32Snapshot(0x00000004, 0)

    $invalidHandle = [IntPtr](-1)
    if ($hSnap -eq $invalidHandle -or $hSnap -eq [IntPtr]::Zero) { return }

    $flaggedCount = 0
    try {
        $te = New-Object AcsThreadCheck+THREADENTRY32
        $te.dwSize = [System.Runtime.InteropServices.Marshal]::SizeOf($te)
        $more = [AcsThreadCheck]::Thread32First($hSnap, [ref]$te)
        while ($more) {
            if ($te.th32OwnerProcessID -eq $proc.Id) {
                $hThread = [IntPtr]::Zero
                try {
                    $hThread = [AcsThreadCheck]::OpenThread($Global:ACS_THREAD_QUERY_LIMITED_INFORMATION, $false, $te.th32ThreadID)
                    if ($hThread -ne [IntPtr]::Zero) {
                        $startAddr = [IntPtr]::Zero
                        $status = [AcsThreadCheck]::NtQueryInformationThread($hThread, $Global:ACS_THREAD_QUERY_START_ADDR, [ref]$startAddr, [IntPtr]::Size, [IntPtr]::Zero)
                        if ($status -eq 0 -and $startAddr -ne [IntPtr]::Zero) {
                            $addrVal = [Int64]$startAddr
                            $backed = $false
                            $ownerModule = $null
                            foreach ($r in $ranges) {
                                if ($addrVal -ge $r.Start -and $addrVal -lt $r.End) { $backed = $true; $ownerModule = $r.Name; break }
                            }
                            if (-not $backed) {
                                $flaggedCount++
                                Write-MonitorLog ("Unbacked thread start address in {0}: thread {1} starts at 0x{2:X} which is outside every mapped module -- consistent with shellcode/manually-mapped executor payload." -f $ProcessName, $te.th32ThreadID, $addrVal) Red -Severity High
                            }
                        }
                    }
                } catch {
                } finally {
                    if ($hThread -ne [IntPtr]::Zero) { [AcsThreadCheck]::CloseHandle($hThread) | Out-Null }
                }
            }
            $more = [AcsThreadCheck]::Thread32Next($hSnap, [ref]$te)
        }
    } finally {
        [AcsThreadCheck]::CloseHandle($hSnap) | Out-Null
    }

    if ($flaggedCount -eq 0) {
        Write-MonitorLog ("Thread scan: all threads in {0} have module-backed start addresses." -f $ProcessName) Green -NoConsole
    }
}

function Test-AmsiPatched {
    if (-not $Global:AcsHookCheckAvailable) { return }

    try {
        $hAmsi = [AcsHookCheck]::GetModuleHandle("amsi.dll")
        if ($hAmsi -eq [IntPtr]::Zero) {

            Write-MonitorLog "AMSI check: amsi.dll is not loaded in this PowerShell process (expected to be present by default)." Yellow -Severity Medium
            return
        }
        $procAddr = [AcsHookCheck]::GetProcAddress($hAmsi, "AmsiScanBuffer")
        if ($procAddr -eq [IntPtr]::Zero) { return }

        $bytes = New-Object byte[] 8
        [Runtime.InteropServices.Marshal]::Copy($procAddr, $bytes, 0, 8)

        $patched = ($bytes[0] -eq 0xB8 -and $bytes[1] -eq 0x57 -and $bytes[2] -eq 0x00 -and $bytes[3] -eq 0x07 -and $bytes[4] -eq 0x80 -and ($bytes[5] -eq 0xC3 -or $bytes[6] -eq 0xC3))

        if (-not $patched) {
            if ($bytes[0] -eq 0xE9 -or $bytes[0] -eq 0xE8) { $patched = $true }
            elseif ($bytes[0] -eq 0xFF -and ($bytes[1] -eq 0x25 -or $bytes[1] -eq 0x15)) { $patched = $true }
        }

        if ($patched) {
            $hex = ($bytes | ForEach-Object { $_.ToString("X2") }) -join " "
            Write-MonitorLog ("AMSI appears patched in this PowerShell process (AmsiScanBuffer bytes: [{0}]) -- something blinded this script's own malware scanning, likely alongside evading detection elsewhere too. Treat the rest of this session's findings as potentially incomplete." -f $hex) Red -Severity Critical
        } else {
            Write-MonitorLog "AMSI check: AmsiScanBuffer looks intact." Green -NoConsole
        }
    } catch {
        Write-MonitorLog ("AMSI check failed: {0}" -f $_.Exception.Message) Yellow -NoConsole
    }
}

