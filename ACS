function Test-SuspiciousMemoryRegions {
    param([string]$ProcessName = "RobloxPlayerBeta", [int]$MaxRegionsToWalk = 20000)

    if (-not $Global:AcsMemScanAvailable) { return }

    $proc = Get-Process -Name $ProcessName -ErrorAction SilentlyContinue | Select-Object -First 1
    if (-not $proc) { return }

    $PROCESS_QUERY_INFORMATION = 0x0400
    $MEM_COMMIT = 0x1000
    $MEM_PRIVATE = 0x20000
    $PAGE_EXECUTE_READWRITE = 0x40
    $PAGE_EXECUTE_WRITECOPY = 0x80

    $hProcess = [AcsMemScan]::OpenProcess($PROCESS_QUERY_INFORMATION, $false, $proc.Id)
    if ($hProcess -eq [IntPtr]::Zero) { return }

    $flagged = New-Object System.Collections.ArrayList
    try {
        $addr = [Int64]0
        $mbi = New-Object AcsMemScan+MEMORY_BASIC_INFORMATION
        $mbiSize = [System.Runtime.InteropServices.Marshal]::SizeOf($mbi)
        $walked = 0

        while ($walked -lt $MaxRegionsToWalk) {
            $result = [AcsMemScan]::VirtualQueryEx($hProcess, [IntPtr]$addr, [ref]$mbi, $mbiSize)
            if ($result -eq [IntPtr]::Zero) { break }

            if ($mbi.State -eq $MEM_COMMIT) {
                $isRwx = ($mbi.Protect -band $PAGE_EXECUTE_READWRITE) -ne 0 -or ($mbi.Protect -band $PAGE_EXECUTE_WRITECOPY) -ne 0
                $isPrivateExec = (($mbi.Type -band $MEM_PRIVATE) -ne 0) -and ($isRwx -or ($mbi.Protect -band 0x10) -ne 0 -or ($mbi.Protect -band 0x20) -ne 0)
                if ($isRwx -or $isPrivateExec) {
                    $null = $flagged.Add([pscustomobject]@{
                        Base = ("0x{0:X}" -f ([Int64]$mbi.BaseAddress))
                        Size = [Int64]$mbi.RegionSize
                        Protect = ("0x{0:X}" -f $mbi.Protect)
                        Rwx = $isRwx
                    })
                }
            }

            $regionSize = [Int64]$mbi.RegionSize
            if ($regionSize -le 0) { break }
            $addr = [Int64]$mbi.BaseAddress + $regionSize
            $walked++
        }
    } finally {
        [AcsMemScan]::CloseHandle($hProcess) | Out-Null
    }

    if ($flagged.Count -gt 0) {

        $lines = @("[Memory Region Scan @ $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] $ProcessName -- $($flagged.Count) RWX/private-executable region(s):")
        foreach ($f in $flagged) { $lines += ("  base={0} size={1} protect={2} rwx={3}" -f $f.Base, $f.Size, $f.Protect, $f.Rwx) }
        Write-MonitorLogRaw -Lines $lines -Severity Medium
    } else {
        Write-MonitorLog ("Memory scan: no RWX/private-executable regions found in {0}." -f $ProcessName) Green -NoConsole
    }
}

function Test-RobloxIatHooks {
    param([string]$ProcessName = "RobloxPlayerBeta")

    if (-not $Global:AcsHookCheckAvailable) { return }

    $proc = Get-Process -Name $ProcessName -ErrorAction SilentlyContinue | Select-Object -First 1
    if (-not $proc) { return }

    try {
        $mainModule = $proc.MainModule
        if (-not $mainModule) { return }
        $exePath = $mainModule.FileName
        if (-not $exePath -or -not (Test-Path $exePath)) { return }

        $moduleRanges = @{}
        foreach ($m in $proc.Modules) {
            $key = $m.ModuleName.ToLower()
            $base = [Int64]$m.BaseAddress
            $moduleRanges[$key] = [pscustomobject]@{ Start = $base; End = ($base + [Int64]$m.ModuleMemorySize) }
        }
        if ($moduleRanges.Count -eq 0) { return }

        $bytes = [System.IO.File]::ReadAllBytes($exePath)
        if ($bytes.Length -lt 0x400) { return }
        $peOffset = [BitConverter]::ToInt32($bytes, 0x3C)
        if ($peOffset -le 0 -or $peOffset -ge ($bytes.Length - 8)) { return }
        $optHeaderOffset = $peOffset + 24
        $magic = [BitConverter]::ToUInt16($bytes, $optHeaderOffset)
        $is64 = ($magic -eq 0x20B)
        $importDirOffset = if ($is64) { $optHeaderOffset + 112 } else { $optHeaderOffset + 96 }
        $importDirRva = [BitConverter]::ToInt32($bytes, $importDirOffset)
        if ($importDirRva -eq 0) { return }

        $numSections = [BitConverter]::ToUInt16($bytes, $peOffset + 6)
        $sizeOfOptHeader = [BitConverter]::ToUInt16($bytes, $peOffset + 20)
        $sectionTableOffset = $optHeaderOffset + $sizeOfOptHeader
        $sections = New-Object System.Collections.Generic.List[psobject]
        for ($i = 0; $i -lt $numSections; $i++) {
            $so = $sectionTableOffset + ($i * 40)
            if ($so + 40 -gt $bytes.Length) { break }
            $vAddr = [BitConverter]::ToInt32($bytes, $so + 12)
            $vSize = [BitConverter]::ToInt32($bytes, $so + 8)
            $rawPtr = [BitConverter]::ToInt32($bytes, $so + 20)
            $sections.Add([pscustomobject]@{ VA = $vAddr; VSize = $vSize; Raw = $rawPtr })
        }
        function Acs-RvaToOffset([int]$rva) {
            foreach ($s in $sections) {
                if ($rva -ge $s.VA -and $rva -lt ($s.VA + $s.VSize)) { return ($s.Raw + ($rva - $s.VA)) }
            }
            return -1
        }

        $imageBaseLive = [Int64]$mainModule.BaseAddress
        $flaggedCount = 0
        $descOffset = Acs-RvaToOffset $importDirRva
        $ptrSize = if ($is64) { 8 } else { 4 }

        while ($descOffset -ge 0 -and ($descOffset + 20) -le $bytes.Length) {
            $origFirstThunkRva = [BitConverter]::ToInt32($bytes, $descOffset)
            $nameRva = [BitConverter]::ToInt32($bytes, $descOffset + 12)
            $firstThunkRva = [BitConverter]::ToInt32($bytes, $descOffset + 16)
            if ($origFirstThunkRva -eq 0 -and $nameRva -eq 0 -and $firstThunkRva -eq 0) { break }

            $nameOffset = Acs-RvaToOffset $nameRva
            $dllName = $null

            if ($nameOffset -ge 0 -and $nameOffset -lt $bytes.Length) {
                $end = $nameOffset
                $maxEnd = [Math]::Min($bytes.Length, $nameOffset + 260)
                while ($end -lt $maxEnd -and $bytes[$end] -ne 0) { $end++ }
                if ($end -gt $nameOffset -and $end -le $bytes.Length) {
                    $dllName = [System.Text.Encoding]::ASCII.GetString($bytes, $nameOffset, $end - $nameOffset)
                }
            }

            if ($dllName -and $moduleRanges.ContainsKey($dllName.ToLower())) {
                $expectedRange = $moduleRanges[$dllName.ToLower()]

                $thunkRva = $firstThunkRva
                $slotOffset = 0
                $hProcess = [AcsHookCheck]::OpenProcess($PROCESS_VM_READ -bor $PROCESS_QUERY_INFORMATION, $false, $proc.Id)
                if ($hProcess -ne [IntPtr]::Zero) {
                    try {
                        while ($true) {
                            $slotAddr = [IntPtr]($imageBaseLive + $thunkRva + $slotOffset)
                            $buf = New-Object byte[] $ptrSize
                            $read = 0
                            $ok = [AcsHookCheck]::ReadProcessMemory($hProcess, $slotAddr, $buf, $ptrSize, [ref]$read)
                            if (-not $ok -or $read -lt $ptrSize) { break }
                            $slotVal = if ($is64) { [BitConverter]::ToInt64($buf, 0) } else { [BitConverter]::ToInt32($buf, 0) }
                            if ($slotVal -eq 0) { break }

                            $isCanonical = ($is64 -eq $false) -or `
                                (($slotVal -ge 0) -and ($slotVal -le 0x00007FFFFFFFFFFF)) -or `
                                ($slotVal -ge -0x8000000000000000 -and $slotVal -lt 0 -and ([UInt64]$slotVal) -ge 0xFFFF800000000000)
                            if ($isCanonical -and ($slotVal -lt $expectedRange.Start -or $slotVal -ge $expectedRange.End)) {
                                $redirectTarget = $null
                                foreach ($kv in $moduleRanges.GetEnumerator()) {
                                    if ($slotVal -ge $kv.Value.Start -and $slotVal -lt $kv.Value.End) { $redirectTarget = $kv.Key; break }
                                }
                                if ($redirectTarget) {
                                    $flaggedCount++
                                    Write-MonitorLog ("IAT hook logged in {0}: an import from {1} resolves to 0x{2:X} inside {3} instead of {1} -- the import table was redirected to a different module." -f $ProcessName, $dllName, $slotVal, $redirectTarget) Red -Severity Medium
                                } else {

                                    $flaggedCount++
                                    Write-MonitorLog ("IAT scan: an import from {0} in {1} resolves to 0x{2:X}, outside {0}'s own mapped range and not backed by any other loaded module -- possible redirect to unmapped memory, treat as unconfirmed rather than a confirmed hook." -f $dllName, $ProcessName, $slotVal) Yellow -Severity Low
                                }
                            }
                            $slotOffset += $ptrSize
                            if ($slotOffset -gt 0x4000) { break }
                        }
                    } finally {
                        [AcsHookCheck]::CloseHandle($hProcess) | Out-Null
                    }
                }
            }

            $descOffset += 20
        }

        if ($flaggedCount -eq 0) {
            Write-MonitorLog ("IAT scan: no redirected imports found in {0}." -f $ProcessName) Green -NoConsole
        }
    } catch {
        Write-MonitorLog ("IAT scan failed (non-fatal): {0}" -f $_.Exception.Message) Yellow -NoConsole
    }
}

