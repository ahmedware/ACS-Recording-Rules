function Get-AcsRegistrySubtreeFingerprint {
    param([Parameter(Mandatory = $true)][string]$Path)
    if (-not (Test-Path -LiteralPath $Path)) { return "MISSING" }

    $parts = New-Object System.Collections.Generic.List[string]
    $subKeyPaths = @()
    try {
        $subKeyPaths = @(Get-ChildItem -Path $Path -Recurse -ErrorAction Stop | Select-Object -ExpandProperty PSPath)
    } catch {}

    foreach ($keyPath in (@($Path) + $subKeyPaths)) {
        try {
            $item = Get-Item -LiteralPath $keyPath -ErrorAction Stop
            foreach ($valueName in $item.GetValueNames()) {
                $raw = $item.GetValue($valueName)
                $rendered = if ($null -eq $raw) { "" }
                    elseif ($raw -is [byte[]]) { "0x" + ([BitConverter]::ToString($raw).Replace("-", "")) }
                    else { [string]$raw }
                $parts.Add("$keyPath|$valueName=$rendered")
            }
        } catch {}
    }
    if ($parts.Count -eq 0) { return "EMPTY" }
    return (($parts | Sort-Object) -join "|")
}

function Get-AcsDefenderRegistryFingerprints {
    $fps = @{ }
    foreach ($root in $Global:AcsDefenderRegRoots) {
        $fps[$root] = Get-AcsRegistrySubtreeFingerprint -Path $root
