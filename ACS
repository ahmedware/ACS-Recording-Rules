    $tempRoots = @($env:TEMP, (Join-Path $env:LOCALAPPDATA "Temp")) | Select-Object -Unique
    foreach ($root in $tempRoots) {
        if (-not (Test-Path $root)) { continue }
        Get-ChildItem -Path $root -Directory -Filter "_MEI*" -ErrorAction SilentlyContinue | ForEach-Object {
            $meiDir = $_.FullName

            if ($Global:PyInstallerDirCache.ContainsKey($meiDir)) {
                $allNames = $Global:PyInstallerDirCache[$meiDir]
            } else {
                $allNames = @(Get-ChildItem -Path $meiDir -Recurse -ErrorAction SilentlyContinue | Select-Object -ExpandProperty Name)
                Set-BoundedCacheEntry -Cache $Global:PyInstallerDirCache -Key $meiDir -Value $allNames -MaxSize 200
            }

            $hits = New-Object System.Collections.Generic.List[string]
            foreach ($marker in $PyInstallerCheatMarkers) {
                if ($allNames | Where-Object { $_ -like "*$marker*" } | Select-Object -First 1) {
                    $hits.Add($marker)
                }
            }
            if ($hits.Count -ge 2) {

                if (Test-AcsSeenOnce -Set $Global:AcsLoggedFindingKeys -Key "PyInstaller|$meiDir") {
                    $ownerName = $null
                    $ownerPidText = $null
                    $ownerPath = $null
                    foreach ($candidate in $procsForOwnerLookup) {
                        try {
                            $moduleHit = $candidate.Modules | Where-Object { $_.FileName -and $_.FileName.StartsWith($meiDir, [System.StringComparison]::OrdinalIgnoreCase) } | Select-Object -First 1
                            if ($moduleHit) {
                                $ownerName = $candidate.ProcessName
                                $ownerPidText = $candidate.Id
                                try { $ownerPath = $candidate.Path } catch {}
                                break
                            }
                        } catch {}
                    }

                    if ($ownerName) {
                        if (-not $ownerPath) { $ownerPath = "(exe path unavailable, folder: $meiDir)" }
                        Write-MonitorLog ("PyInstaller extraction signature logged: {0} -> {1} (PID {2})" -f ($hits -join ', '), $ownerName, $ownerPidText) Red -Severity Medium
                    } else {
                        Write-MonitorLog ("PyInstaller extraction signature logged: {0}, owner not resolved -- folder: {1}" -f ($hits -join ', '), $meiDir) Red -Severity Medium
                    }
                }
            }
        }
    }
}

