function Add-AcsReviewedFinding {
    param(
        [Parameter(Mandatory = $true)][string]$Identifier,
        [Parameter(Mandatory = $true)][ValidateSet("dismissed", "confirmed-benign", "confirmed-cheat", "needs-followup")][string]$Verdict,
        [string]$Note = ""
