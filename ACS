        Invoke-MonitorCheckSafely "ThreadStartAddresses" { Test-ThreadStartAddresses -ProcessName "RobloxPlayerBeta" }
        Invoke-MonitorCheckSafely "SuspiciousMemoryRegions" { Test-SuspiciousMemoryRegions -ProcessName "RobloxPlayerBeta" }
        Invoke-MonitorCheckSafely "RobloxIatHooks" { Test-RobloxIatHooks -ProcessName "RobloxPlayerBeta" }

        foreach ($flaggedPid in @($Global:FlaggedExternalHandlePids)) {
            Invoke-MonitorCheckSafely "PESieveFlaggedPid($flaggedPid)" { Test-PESieveForRoblox -ProcessId $flaggedPid }
        }

        $lastPesieveScan = Get-Date
    }

    if (((Get-Date) - $lastStatus).TotalSeconds -ge 8) {
        Invoke-MonitorCheckSafely "ShowMonitorStatus" { Show-MonitorStatus }
        $lastStatus = Get-Date
    }

    Start-Sleep -Milliseconds 150
}

if ($Global:AcsProcessWatcherActive) {
    try { Unregister-Event -SourceIdentifier "ACS_ProcessStart" -ErrorAction SilentlyContinue } catch {}

    try { Get-Event -SourceIdentifier "ACS_ProcessStart" -ErrorAction SilentlyContinue | Remove-Event -ErrorAction SilentlyContinue } catch {}
}

Write-Host ""
Write-ColoredLine "Match monitoring stopped." Green
