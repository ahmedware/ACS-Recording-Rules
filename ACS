# --- BAM/DAM + Prefetch deletion tampering ---
# Clearing a whole event log is one way to cover tracks; deleting a single BAM/DAM
# execution record or a single .pf file is a quieter, targeted way to erase evidence
# that one specific program ran. Neither Test-NewPersistenceEntries nor
# Test-EventLogTampering catches that, so this tracks a baseline of BAM/DAM value
# names and Prefetch file names and flags anything that disappears mid-session, plus
# any newly-appeared Prefetch file whose name matches a known-cheat keyword.
$Global:AcsBamDamRoots = @(
    "HKLM:\SYSTEM\CurrentControlSet\Services\bam\State\UserSettings",
    "HKLM:\SYSTEM\CurrentControlSet\Services\dam\State\UserSettings"
)

function Get-AcsBamPrefetchSnapshot {
    $entries = New-Object System.Collections.Generic.HashSet[string]

    foreach ($root in $Global:AcsBamDamRoots) {
        if (-not (Test-Path -LiteralPath $root)) { continue }
        try {
            Get-ChildItem -Path $root -ErrorAction Stop | ForEach-Object {
                if ($_.PSChildName -eq "S-1-5-18") { return }
                try {
                    $item = Get-Item -LiteralPath $_.PSPath -ErrorAction Stop
                    foreach ($valueName in $item.GetValueNames()) {
                        if ($valueName) { $null = $entries.Add("BAM|$root|$($_.PSChildName)|$valueName") }
                    }
                } catch {}
            }
        } catch {}
    }

    $prefetchPath = Join-Path $env:WINDIR "Prefetch"
    if (Test-Path -LiteralPath $prefetchPath) {
        try {
            Get-ChildItem -Path $prefetchPath -Filter "*.pf" -ErrorAction Stop | ForEach-Object {
                $null = $entries.Add("PF|$($_.Name)")
            }
        } catch {}
    }

    return $entries
}

$Global:AcsBamPrefetchBaseline = $null

function Test-BamPrefetchTampering {
    if ($null -eq $Global:AcsBamPrefetchBaseline) {
        $Global:AcsBamPrefetchBaseline = Get-AcsBamPrefetchSnapshot
        return
    }
    $current = Get-AcsBamPrefetchSnapshot

    foreach ($entry in $Global:AcsBamPrefetchBaseline) {
        if ($current.Contains($entry)) { continue }
        if (-not (Test-AcsSeenOnce -Set $Global:AcsLoggedFindingKeys -Key "BamPrefetchDeleted|$entry")) { continue }

        $label = ($entry -split '\|')[-1]
        if ($entry.StartsWith("PF|")) {
            Write-MonitorLog ("Prefetch file REMOVED mid-session: {0} -- deleting a single .pf file (rather than clearing a whole log) is a targeted way to erase evidence that one specific program ran." -f $label) Red -Severity Critical
        } else {
            Write-MonitorLog ("BAM/DAM execution record REMOVED mid-session: {0} -- this registry value records that a specific program ran; its disappearance mid-session is not something normal Windows behavior does on its own." -f $label) Red -Severity Critical
        }
    }

    foreach ($entry in $current) {
        if (-not $entry.StartsWith("PF|")) { continue }
        if ($Global:AcsBamPrefetchBaseline.Contains($entry)) { continue }
        $pfName = ($entry -split '\|', 2)[1]
        $kw = Get-AcsMatchedCheatKeyword -Text $pfName
        if ($kw -and (Test-AcsSeenOnce -Set $Global:AcsLoggedFindingKeys -Key "NewPrefetchCheatKeyword|$pfName")) {
            Write-MonitorLog ("New Prefetch entry matching known-cheat keyword '{0}' appeared mid-session: {1} -- this means the matching program actually executed on this machine during the recording window." -f $kw, $pfName) Red -Severity High
        }
    }

    $Global:AcsBamPrefetchBaseline = $current
}

# --- Registry editor running mid-session ---
# Not proof of tampering by itself (plenty of legitimate reasons to open regedit),
# but it's an unusual thing for a player to be doing mid-match, and worth a
# reviewer's manual look at what was touched around this timestamp.
function Test-RegistryToolRunning {
    param($Snapshot = $null)
    $procs = if ($Snapshot) { $Snapshot } else { Get-Process -ErrorAction SilentlyContinue }
    foreach ($proc in $procs) {
        if ($proc.ProcessName -notin @("regedit", "reg")) { continue }
        if (-not (Test-AcsSeenOnce -Set $Global:AcsLoggedFindingKeys -Key "RegistryTool|$($proc.Id)")) { continue }
