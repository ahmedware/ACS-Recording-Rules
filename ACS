                }
            } else {
                if (Test-AcsSeenOnce -Set $Global:AcsLoggedFindingKeys -Key "IdentityMismatch|$ownerName|$ownerPid") {
                    Write-MonitorLog ("PROCESS IDENTITY MISMATCH: {0} (PID {1}) path='{2}' owns an overlay window over Roblox and presents as the trusted name '{3}' but its identity could not be verified -- {4}. This is exactly the pattern of a process renamed to blend into a trusted-name allowlist." -f $ownerName, $ownerPid, $ownerPath, $ownerName, $identity.Reason) Red -Severity Critical
                }
            }
        }

        if (Test-AcsSeenOnce -Set $Global:AcsLoggedFindingKeys -Key "OverlayWindows|$ownerName|$ownerPid") {
            Write-MonitorLog ("OVERLAY WINDOW LOGGED: {0} (PID {1}) title='{2}' size={3}x{4} overlap={5:P0} of game window path='{6}'" -f $ownerName, $ownerPid, $win.Title, $width, $height, ($overlapArea / $robloxArea), $ownerPath) Red -Severity High
        }
    }
}

function Test-KernelDrivers {
    param(
        [string]$KnownDriversUrl = $Global:KNOWN_DRIVERS_URL,
        [int]$MaxDriverNameLen = 80
    )

    $suspects = New-Object System.Collections.ArrayList
    $infoLines = New-Object System.Collections.ArrayList
    $knownDrivers = @{ }

    if ($null -eq $Global:KnownDriversCache -and -not $Global:KnownDriversCacheAttempted) {
        $Global:KnownDriversCacheAttempted = $true
        $Global:KnownDriversCache = @{ }
        if ($KnownDriversUrl) {
            try {

                $rawResponse = Invoke-WebRequest -Uri $KnownDriversUrl -UseBasicParsing -TimeoutSec 8 -ErrorAction Stop
                $rawContent = $rawResponse.Content

                if ($Global:KNOWN_DRIVERS_EXPECTED_SHA256) {
                    $sha256 = [System.Security.Cryptography.SHA256]::Create()
                    $actualHash = ([BitConverter]::ToString($sha256.ComputeHash([System.Text.Encoding]::UTF8.GetBytes($rawContent)))).Replace("-", "")
                    if ($actualHash -ne $Global:KNOWN_DRIVERS_EXPECTED_SHA256) {
                        Write-MonitorLog ("Known-drivers feed hash mismatch (pinned in `$Global:AcsConfig, got {0}) -- refusing to use this feed for the rest of the session; falling back to local heuristics only." -f $actualHash) Red -Severity High
                        throw "known-drivers feed hash mismatch"
                    }
                } else {

                    Write-MonitorLog "Known-drivers feed (KnownDriversUrl) has no pinned SHA256 (KnownDriversSha256 in `$Global:AcsConfig) -- content is trusted WITHOUT integrity verification." Yellow -Severity Medium
                }

                $json = $rawContent | ConvertFrom-Json
                if ($json -is [System.Collections.IDictionary]) {
                    foreach ($k in $json.Keys) { $Global:KnownDriversCache[$k.ToLower()] = $json[$k] }
                } elseif ($json -is [System.Array]) {
                    foreach ($entry in $json) {
                        $nm = if ($entry -is [string]) { $entry } else { $entry.name -as [string] }
                        if ($nm) { $Global:KnownDriversCache[$nm.ToLower()] = $true }
                    }
                }

                $Global:KnownDriversHashCache = @{}
                try {
                    $rawEntries = if ($json -is [System.Array]) { $json } elseif ($json.PSObject.Properties['Verified']) { $json.Verified } else { @() }
                    foreach ($entry in $rawEntries) {
                        $samples = $null
                        if ($entry.PSObject.Properties['KnownVulnerableSamples']) { $samples = $entry.KnownVulnerableSamples }
                        elseif ($entry.PSObject.Properties['Tags']) { $samples = @($entry) }
                        if (-not $samples) { continue }
                        foreach ($s in $samples) {
                            foreach ($hashField in @('SHA256', 'Sha256', 'sha256')) {
                                if ($s.PSObject.Properties[$hashField] -and $s.$hashField) {
                                    $Global:KnownDriversHashCache[$s.$hashField.ToString().ToLower()] = $true
                                }
                            }
                        }
                    }
                } catch {

                }
            } catch {

                Write-MonitorLog ("WARNING: Couldn't fetch known-driver list: {0}" -f $_.Exception.Message) Yellow
            }
        }
    }
    $knownDrivers = $Global:KnownDriversCache
    if ($null -eq $knownDrivers) { $knownDrivers = @{ } }

    foreach ($localName in $Global:AcsLocalKnownVulnerableDrivers) {
        if (-not $knownDrivers.ContainsKey($localName)) { $knownDrivers[$localName] = "local-blocklist" }
    }

    try {
        $drivers = Get-CimInstance Win32_SystemDriver -ErrorAction Stop
    } catch {
        Write-MonitorLog ("WARNING: Couldn't enumerate Win32_SystemDriver: {0}" -f $_.Exception.Message) Yellow
        return @{
            Summary = "driver-scan-failed"
            SuspectCount = 0
        }
    }

    foreach ($d in $drivers) {
        $name = $d.Name
        $state = $d.State
        $pathRaw = $d.PathName -as [string]
        if ($pathRaw) { $path = $pathRaw.Trim('"') } else { $path = $null }

        $flagged = $false
        $reasons = @()

        if ($path) {
            try {

                $filePath = $path -replace '^\^?', ''
                if ($filePath -match '^\\SystemRoot\\') {
                    $filePath = $filePath -replace '^\\SystemRoot\\', "$env:SystemRoot\"
                } elseif ($filePath -match '^\\\?\?\\') {
                    $filePath = $filePath -replace '^\\\?\?\\', ''
                } elseif ($filePath -notmatch '^[A-Za-z]:\\' -and $filePath -notmatch '^\\\\') {
                    $filePath = Join-Path $env:SystemRoot $filePath
                }
                if (Test-Path $filePath) {
                    $driverFingerprint = $null
                    try {
                        $fi = Get-Item -LiteralPath $filePath -ErrorAction Stop
                        $driverFingerprint = "$($fi.Length)|$($fi.LastWriteTimeUtc.Ticks)"
                    } catch {}
                    $cachedSig = $Global:DriverSigCache[$filePath]

                    if ($cachedSig -and $driverFingerprint -and $cachedSig.Fingerprint -eq $driverFingerprint) {
                        if ($cachedSig.Trusted) {
                            Write-WhitelistLog ("Recognized publisher (list: AcsTrustedModulePublishers, cached): {0} (status: {1}) -- driver still logged below, not skipped." -f $filePath, $cachedSig.Status)
                            $flagged = $true
                            $reasons += "signed-by-recognized-publisher ($($cachedSig.Status)) -- logged for visibility, no longer auto-trusted"
                        } else {
                            $flagged = $true
                            $reasons += "unsigned-or-untrusted-signer ($($cachedSig.Status))"
                        }
                    } else {
                        try {
                            $sig = Get-AuthenticodeSignature -FilePath $filePath -ErrorAction Stop

                            $trusted = $false
                            $matchedPublisher = $null
                            if ($sig.Status -eq 'Valid') {
                                foreach ($pub in $AcsTrustedModulePublishers) {
                                    if ($sig.SignerCertificate.Subject -match [regex]::Escape($pub)) { $trusted = $true; $matchedPublisher = $pub; break }
                                }
                            }
                            if ($driverFingerprint) {
                                Set-BoundedCacheEntry -Cache $Global:DriverSigCache -Key $filePath -Value ([pscustomobject]@{ Fingerprint = $driverFingerprint; Trusted = $trusted; Status = $sig.Status }) -MaxSize 1000
                            }
                            if ($sig.Status -ne 'Valid') {
                                $flagged = $true
                                $reasons += "unsigned-or-untrusted-signer ($($sig.Status))"
                            } elseif ($trusted) {
                                Write-WhitelistLog ("Recognized publisher (list: AcsTrustedModulePublishers): {0} (matched: {1}) -- driver still logged below, not skipped." -f $filePath, $matchedPublisher)
                                $flagged = $true
                                $reasons += "signed-by-recognized-publisher ($matchedPublisher) -- logged for visibility, no longer auto-trusted"
                            } else {
                                $flagged = $true
                                $reasons += "unrecognized-signer ($($sig.SignerCertificate.Subject))"
                            }
                        } catch {
                            $flagged = $true
                            $reasons += "signature-check-failed"
                        }
                    }

                    if ($filePath -match "\\(Temp|Downloads|AppData\\Local\\Temp)\\" -or $filePath -match "\\Users\\[^\\]+\\Downloads\\") {
                        $flagged = $true
                        $reasons += "loaded-from-temp-or-downloads"
                    }

                    if ($reasons -contains "unsigned-or-untrusted-signer (NotSigned)" -and
                        $filePath -like "$env:SystemRoot\System32\drivers\*") {
                        $reasons = $reasons | Where-Object { $_ -ne "unsigned-or-untrusted-signer (NotSigned)" }
                        $reasons += "likely-catalog-signed-inbox-driver (not cryptographically verified)"
                        if ($reasons.Count -eq 1) { $flagged = $false }
                    }
                } else {
                    $flagged = $true
                    $reasons += "driver-file-not-found"
                }
            } catch {}
        } else {
            $flagged = $true
            $reasons += "no-path-recorded"
        }

        $baseName = if ($path) { [IO.Path]::GetFileName($path).ToLower() } else { $name.ToLower() }
        if ($knownDrivers.ContainsKey($baseName)) {
            $flagged = $true
            $reasons += "known-abusable-driver-name"
        }

        if ($filePath -and (Test-Path $filePath) -and $Global:KnownDriversHashCache.Count -gt 0) {
            try {
                $driverHash = (Get-FileHash -LiteralPath $filePath -Algorithm SHA256 -ErrorAction Stop).Hash.ToLower()
                if ($Global:KnownDriversHashCache.ContainsKey($driverHash)) {
                    $flagged = $true
                    $reasons += "known-vulnerable-driver-hash-match (BYOVD, independent of signature validity)"
                }
            } catch {}
        }

        if ($AcsKnownByovdDriverNames -contains $name) {
            $flagged = $true
            $reasons += "known-byovd-target-name (commonly bundled legitimately with MSI Afterburner/RivaTuner; also one of the most common signed-but-vulnerable drivers loaded deliberately by kernel-level cheats for kernel r/w -- valid signature does not rule this out, CVE-2019-18845)"
        }

        $info = @{
            Name = $name
            State = $state
            Path = $path
            Flagged = $flagged
            Reasons = $reasons
        }

        if ($flagged) {
            $null = $suspects.Add((New-Object psobject -Property $info)) > $null
        } else {
            $null = $infoLines.Add("driver ok: $name | state: $state | path: $path") > $null
        }
    }

    $newSuspectsThisScan = @($suspects | Where-Object { Test-AcsSeenOnce -Set $Global:AcsLoggedFindingKeys -Key "KernelDrivers|$($_.Path)" })

    $logLines = @()
    $logLines += ("[Driver Scan @ {0}]" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"))
    $logLines += ("driver count: {0} | total flagged so far this session: {1} | new this scan: {2}" -f $drivers.Count, $suspects.Count, $newSuspectsThisScan.Count)

    if ($newSuspectsThisScan.Count -gt 0) {
        $logLines += ""
        foreach ($s in $newSuspectsThisScan) {
            $logLines += ("SUSPECT DRIVER: {0} | state: {1} | path: {2} | reasons: {3}{4}{5}" -f $s.Name, $s.State, $s.Path, ($s.Reasons -join ', '), (Get-AcsReviewNote -Identifier $s.Path), (Get-AcsNewSinceLastSessionNote -Identifier $s.Path))
        }
    }

    if ($infoLines.Count -gt 0 -and (Test-AcsSeenOnce -Set $Global:AcsLoggedFindingKeys -Key "KernelDrivers|BenignSample")) {
        $sample = $infoLines | Select-Object -First 10
        $logLines += ""
        $logLines += "INFO: sample of non-flagged drivers (first 10)"
        $logLines += $sample
    }

    $driverScanSeverity = if ($newSuspectsThisScan.Count -gt 0) { "Critical" } else { "Info" }
    Write-DriverLogRaw -Lines ($logLines | ForEach-Object { "[{0}] {1}" -f (Get-Date -Format "HH:mm:ss"), $_ }) -Severity $driverScanSeverity

    if ($newSuspectsThisScan.Count -gt 0) {
        Write-MonitorLog ("Driver scan: {0} new suspect driver(s) logged this scan ({1} total flagged this session, out of {2} checked) -- see 'Suspicious Driver Check.log' for full detail." -f $newSuspectsThisScan.Count, $suspects.Count, $drivers.Count) Yellow -Severity Info
    } else {
        Write-MonitorLog ("Driver scan: no new suspicious drivers this scan ({0} total flagged this session, {1} checked) -- see 'Suspicious Driver Check.log' for full detail." -f $suspects.Count, $drivers.Count) Green -NoConsole
    }

    if ($newSuspectsThisScan.Count -gt 0) {
        Write-Host ("[{0}] DRIVER SCAN: New Driver(s) Logged: {1}" -f (Get-Date -Format "HH:mm:ss"), $newSuspectsThisScan.Count) -ForegroundColor Green
    } else {
        Write-Host ("[{0}] DRIVER SCAN: No new suspicious drivers" -f (Get-Date -Format "HH:mm:ss")) -ForegroundColor Green
    }

    return @{
        Summary = "driver-scan-complete"
        SuspectCount = $suspects.Count
        Suspects = $suspects
    }
}

