$Global:AcsDnsCache = @{ }
function Get-CachedHostname {
    param([string]$IPAddress)
    if ($Global:AcsDnsCache.ContainsKey($IPAddress)) { return $Global:AcsDnsCache[$IPAddress] }

    $hostname = $null
    try {
        $task = [System.Net.Dns]::GetHostEntryAsync($IPAddress)
        if ($task.Wait(800)) {
            $hostname = $task.Result.HostName
        }
    } catch {}

    $Global:AcsDnsCache[$IPAddress] = $hostname
    return $hostname
}

function Test-IsPrivateOrLocalIP {
    param([string]$IPAddress)
    if ($IPAddress -in @("127.0.0.1", "::1", "0.0.0.0")) { return $true }
    if ($IPAddress -match '^169\.254\.') { return $true }
    if ($IPAddress -match '^10\.') { return $true }
    if ($IPAddress -match '^192\.168\.') { return $true }
    if ($IPAddress -match '^172\.(1[6-9]|2[0-9]|3[0-1])\.') { return $true }
    return $false
}

function Test-SuspiciousNetworkConnections {
    if ($AcsNetworkIocDomains.Count -eq 0) { return }
    if (-not (Get-Process -Name "RobloxPlayerBeta" -ErrorAction SilentlyContinue)) { return }

    try {
        $connections = @(Get-NetTCPConnection -State Established -ErrorAction Stop)
    } catch {
        return
    }

    $uniqueRemotes = @($connections | Where-Object { -not (Test-IsPrivateOrLocalIP $_.RemoteAddress) } |
        Select-Object -ExpandProperty RemoteAddress -Unique | Select-Object -First 40)

    $scanBudget = [System.Diagnostics.Stopwatch]::StartNew()
    $maxScanMs = 4000

    foreach ($remoteIp in $uniqueRemotes) {
        if ($scanBudget.ElapsedMilliseconds -ge $maxScanMs) { break }

        $hostname = Get-CachedHostname -IPAddress $remoteIp
        if (-not $hostname) { continue }
        $hostnameLower = $hostname.ToLower().TrimEnd('.')

        $matchedDomain = $null
        foreach ($domain in $AcsNetworkIocDomains) {
            if ($hostnameLower -eq $domain -or $hostnameLower.EndsWith(".$domain")) {
                $matchedDomain = $domain
                break
            }
        }
        if (-not $matchedDomain) { continue }

        $owners = @($connections | Where-Object { $_.RemoteAddress -eq $remoteIp } | Select-Object -ExpandProperty OwningProcess -Unique)
        foreach ($ownerPid in $owners) {
            $ownerName = "(unknown)"
            $ownerPath = "(path unavailable)"
            try {
                $ownerProc = Get-Process -Id $ownerPid -ErrorAction Stop
                $ownerName = $ownerProc.ProcessName
                if ($ownerProc.Path) { $ownerPath = $ownerProc.Path }
            } catch {}

            Write-MonitorLog ("NETWORK IOC LOGGED: {0} (PID {1}) path='{2}' connected to {3} ({4}, matched known cheat-infrastructure domain '{5}')" -f $ownerName, $ownerPid, $ownerPath, $remoteIp, $hostname, $matchedDomain) Red -Severity Medium
        }
    }
}

function Test-PESieveForRoblox {

    param(
        [string]$ProcessName,
        [int]$ProcessId
    )

    $results = New-Object System.Collections.Generic.List[string]

    $proc = $null
    if ($ProcessId) {
        $proc = Get-Process -Id $ProcessId -ErrorAction SilentlyContinue
        if (-not $proc) { $results.Add("INFO: PID $ProcessId no longer running"); return $results }
    } else {
        if (-not $ProcessName) { $ProcessName = "RobloxPlayerBeta" }
        $proc = Get-Process -Name $ProcessName -ErrorAction SilentlyContinue | Select-Object -First 1
        if (-not $proc) {
            $results.Add("INFO: $ProcessName not running")
            return $results
        }
    }

    if (-not $Global:PESIEVE_URL) {
        $results.Add("WARNING: PESieve URL not configured; skipping memory-region scan")
        return $results
    }

    $pesieveExe = Get-ForensicTool -Name "PESieve" -ZipUrl $Global:PESIEVE_URL -ExeFilter "pe-sieve64.exe"
    if (-not $pesieveExe) {
        $results.Add("FAIL: pesieve not available")
        return $results
    }

    if ($Global:PESIEVE_EXPECTED_SHA256) {
        try {
            $actual = (Get-FileHash -LiteralPath $pesieveExe.FullName -Algorithm SHA256).Hash
            if ($actual -ne $Global:PESIEVE_EXPECTED_SHA256) {
                $results.Add("FAIL: Pesieve binary hash mismatch (found $actual)")
                return $results
            }
        } catch {
            $results.Add("WARNING: Failed to check pesieve hash: $($_.Exception.Message)")
        }
    } else {

        if (-not $Global:PesieveUnpinnedWarned) {
            Write-MonitorLog "PE-sieve binary has no pinned SHA256 (PesieveSha256 in `$Global:AcsConfig) -- downloaded and run WITHOUT integrity verification. Set a pin once you've confirmed a known-good hash." Yellow -Severity Medium
            $Global:PesieveUnpinnedWarned = $true
        }
    }

    $jsonOut = Join-Path $env:TEMP ("pesieve_out_{0}_{1}.json" -f $proc.Id, (Get-Random))
    $exe = $pesieveExe.FullName

    try {
        $args = @("-pid", $proc.Id.ToString(), "-sc", "-o", $jsonOut, "-silent")
        & $exe @args 2>$null | Out-Null
        Start-Sleep -Milliseconds 300
    } catch {
        $results.Add("ERROR: pesieve execution failed: $($_.Exception.Message)")
        return $results
    }

    if (-not (Test-Path $jsonOut)) {
        try {
            $raw = & $exe -pid $proc.Id -sc -silent 2>$null
            foreach ($line in $raw) {
                if ($line -match '(Infected|suspicious|Injected|Manual map|RWX)') {
                    Write-MonitorLog ("PE-sieve detection logged: {0}" -f $line) Red -Severity High
                    $results.Add("LOG: $line")
                }
            }
        } catch {
            $results.Add("ERROR: pesieve run/no output: $($_.Exception.Message)")
        }
        return $results
    }

    try {
        $jsonText = Get-Content -LiteralPath $jsonOut -Raw -ErrorAction Stop
        $parsed = ConvertFrom-Json -InputObject $jsonText -ErrorAction Stop

        if ($parsed.results) {
            foreach ($r in $parsed.results) {
                if ($r.scan_result -and $r.scan_result -ne "OK") {
                    $msg = "PESieve result: $($r.module_name) -> $($r.scan_result)"
                    Write-MonitorLog $msg Red
                    $results.Add($msg)
                }
            }
        } elseif ($parsed.infections) {
            foreach ($inf in $parsed.infections) {
                $msg = "PESieve infection: $($inf.module) -> $($inf.details)"
                Write-MonitorLog $msg Red
                $results.Add($msg)
            }
        } else {
            $text = $jsonText
            if ($text -match '(injected|manual map|RWX|suspicious|IAT hook)') {
                Write-MonitorLog "PESieve produced suspicious markers" Red -Severity High
                $results.Add("LOG: pesieve produced suspicious markers")
            } else {
                $results.Add("INFO: pesieve scan completed, no obvious hits")
            }
        }
    } catch {
        $results.Add("WARNING: Couldn't parse pesieve output: $($_.Exception.Message)")
    } finally {
        try { Copy-Item -LiteralPath $jsonOut -Destination (Join-Path $outputPath ("pesieve_{0}.json" -f $proc.Id)) -Force -ErrorAction SilentlyContinue } catch {}
    }

    return $results
}

