function Test-AcsAllowlistIdentityVerified {
    param(
        [Parameter(Mandatory = $true)][string]$MatchedName,
        [Parameter(Mandatory = $true)][string]$ProcPath
    )

    if (-not $ProcPath -or $ProcPath -eq "(path unavailable)" -or -not (Test-Path -LiteralPath $ProcPath -ErrorAction SilentlyContinue)) {

        if ($MatchedName -in @("System", "Registry")) { return @{ Verified = $true; Reason = "pseudo-process, no file to verify" } }
        return @{ Verified = $false; Reason = "no backing file could be resolved to verify" }
    }

    if ($Global:AcsAllowlistExpectedSigner.ContainsKey($MatchedName)) {
        $expected = $Global:AcsAllowlistExpectedSigner[$MatchedName]
        if ($null -eq $expected) { return @{ Verified = $true; Reason = "pseudo-process, no file to verify" } }
        try {
            $sig = Get-AuthenticodeSignature -LiteralPath $ProcPath -ErrorAction Stop
            if ($sig.Status -eq "Valid" -and $sig.SignerCertificate -and $sig.SignerCertificate.Subject -match [regex]::Escape($expected)) {
                return @{ Verified = $true; Reason = "signature verified, publisher matches '$expected'" }
            }
            $subj = if ($sig.SignerCertificate) { $sig.SignerCertificate.Subject } else { "(none)" }
            return @{ Verified = $false; Reason = "expected publisher '$expected' but got signature status=$($sig.Status) subject='$subj'" }
        } catch {
            return @{ Verified = $false; Reason = "signature check failed: $($_.Exception.Message)" }
        }
    }

    if ($Global:AcsAllowlistPathOnlyNames -contains $MatchedName) {
        if ($ProcPath -match "\\(Temp|Downloads|AppData\\Local\\Temp)\\" -or $ProcPath -match "\\Users\\[^\\]+\\Desktop\\") {
            return @{ Verified = $false; Reason = "running from '$ProcPath', not a normal install location for this tool (publisher signature isn't reliably verifiable for this name, so path is the only available signal)" }
        }
        return @{ Verified = $true; Reason = "path plausible (publisher signature not reliably verifiable for this tool)" }
    }

    return @{ Verified = $false; Reason = "no verification rule defined for this allowlist entry" }
}

function Test-KnownCheatNames {
    param($Snapshot = $null)
    $procs = if ($Snapshot) { $Snapshot } else { Get-Process -ErrorAction SilentlyContinue }
    $procs | ForEach-Object {
        $proc = $_

        $procPath = ""
        try { if ($proc.Path) { $procPath = $proc.Path } } catch {}
        if (-not $procPath) {
            try {
                $cimMatch = Get-CimInstance Win32_Process -Filter "ProcessId = $($proc.Id)" -ErrorAction Stop
                if ($cimMatch -and $cimMatch.ExecutablePath) { $procPath = $cimMatch.ExecutablePath }
            } catch {}
        }
        if (-not $procPath) { $procPath = "(path unavailable)" }

        foreach ($safe in $RobloxHandleOwnerAllowlist) {
            if ($proc.ProcessName -ieq $safe) {
                $identity = Test-AcsAllowlistIdentityVerified -MatchedName $safe -ProcPath $procPath
                if ($identity.Verified) {
                    if (Test-AcsSeenOnce -Set $Global:AcsLoggedWhitelistKeys -Key "KnownCheatNames|$safe|$($proc.Id)") {
                        Write-WhitelistLog ("Recognized process (list: RobloxHandleOwnerAllowlist): {0} (PID {1}) path='{2}' -- {3}; still checked below, not skipped." -f $proc.ProcessName, $proc.Id, $procPath, $identity.Reason)
                    }
                } else {
                    if (Test-AcsSeenOnce -Set $Global:AcsLoggedFindingKeys -Key "IdentityMismatch|$safe|$($proc.Id)") {
                        Write-MonitorLog ("PROCESS IDENTITY MISMATCH: {0} (PID {1}) path='{2}' presents as the trusted name '{3}' but its identity could not be verified -- {4}. This is exactly the pattern of a process renamed to blend into a trusted-name allowlist." -f $proc.ProcessName, $proc.Id, $procPath, $safe, $identity.Reason) Red -Severity Critical
                    }
                }
                break
            }
        }

        $haystack = @($proc.ProcessName, $proc.MainWindowTitle) -join " "
        try { if ($procPath -ne "(path unavailable)") { $haystack += " " + $procPath } } catch {}
        try { $haystack += " " + $proc.MainModule.FileVersionInfo.ProductName } catch {}

        foreach ($fragment in $KnownCheatNameFragments) {
